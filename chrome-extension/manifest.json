{
  "manifest_version": 3,
  "name": "Horizon Stream PSN Account ID",
  "description": "Transfer a one-time PS Remote Play sign-in redirect to Horizon Stream with a QR code.",
  "version": "0.6.1",
  "key": "",
  "action": {
    "default_title": "Horizon Stream PSN Account ID",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://remoteplay.dl.playstation.net/*"
  ]
}
